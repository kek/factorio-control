// Exact, read-only health/presence check for half the completed wall perimeter.
let points=[ {x2:129,y2:-63},
 {x2:91,y2:-61},
 {x2:129,y2:-61},
 {x2:91,y2:-59},
 {x2:129,y2:-59},
 {x2:91,y2:-57},
 {x2:129,y2:-57},
 {x2:91,y2:-55},
 {x2:129,y2:-55},
 {x2:91,y2:-53},
 {x2:129,y2:-53},
 {x2:91,y2:-51},
 {x2:129,y2:-51},
 {x2:91,y2:-49},
 {x2:129,y2:-49},
 {x2:91,y2:-47},
 {x2:129,y2:-47},
 {x2:91,y2:-45},
 {x2:129,y2:-45},
 {x2:91,y2:-43},
 {x2:129,y2:-43},
 {x2:91,y2:-41},
 {x2:129,y2:-41},
 {x2:91,y2:-39},
 {x2:129,y2:-39},
 {x2:129,y2:-37},
 {x2:129,y2:-35},
 {x2:91,y2:-33},
 {x2:129,y2:-33},
 {x2:91,y2:-31},
 {x2:129,y2:-31},
 {x2:91,y2:-29},
 {x2:129,y2:-29},
 {x2:91,y2:-27},
 {x2:129,y2:-27},
 {x2:91,y2:-25},
 {x2:129,y2:-25},
 {x2:91,y2:-23},
 {x2:129,y2:-23},
 {x2:91,y2:-21},
 {x2:129,y2:-21},
 {x2:91,y2:-19},
 {x2:129,y2:-19},
 {x2:91,y2:-17},
 {x2:129,y2:-17},
 {x2:91,y2:-15},
 {x2:129,y2:-15},
 {x2:91,y2:-13},
 {x2:129,y2:-13},
 {x2:91,y2:-11},
 {x2:129,y2:-11},
 {x2:91,y2:-9},
 {x2:129,y2:-9}]
let result=!list_fold(points,{checked:0,missing:0,damaged:0},(p,n)->{
 match perform InspectMachine({name:"stone-wall",position:p}) {
  Ok(s)->{let damaged=match !int_compare(s.machine.health_milli,s.machine.max_health_milli) {Lt(_)->{!int_add(n.damaged,1)} | (_)->{n.damaged}}
   {checked:!int_add(n.checked,1),missing:n.missing,damaged:damaged}}
  Error(_)->{{checked:!int_add(n.checked,1),missing:!int_add(n.missing,1),damaged:n.damaged}}
 }
})
{success:!equal(result.missing,0),checked:result.checked,missing:result.missing,damaged:result.damaged}
