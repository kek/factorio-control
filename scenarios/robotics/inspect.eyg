let tech=(name)->{match perform InspectTechnology({name:name}) {Ok(s)->{{name:name,current:s.technology.current,researched:s.technology.researched,progress:s.technology.progress_milli,error:""}} Error(e)->{{name:name,current:False({}),researched:False({}),progress:0,error:e}}}}
let machine=(name,x,y)->{match perform InspectMachine({name:name,position:{x2:x,y2:y}}) {Ok(s)->{{name:name,x:x,y:y,status:s.machine.status,input:s.machine.input,output:s.machine.output,inventory:s.machine.inventory,health:s.machine.health_milli,error:""}} Error(e)->{{name:name,x:x,y:y,status:"missing",input:[],output:[],inventory:[],health:0,error:e}}}}
{technologies:[tech("electric-mining-drill"),tech("steel-processing"),tech("logistic-science-pack")],machines:[machine("assembling-machine-1",71,-49),machine("iron-chest",77,-49),machine("lab",87,-51),machine("iron-chest",51,-75),machine("iron-chest",67,-75),machine("iron-chest",59,-75),machine("assembling-machine-1",111,-45)]}
