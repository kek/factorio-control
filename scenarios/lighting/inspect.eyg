// Read-only check of the eight installed lamps. Input positions are half tiles.
let lamp=(x,y)->{match perform InspectMachine({name:"small-lamp",position:{x2:x,y2:y}}) {Ok(s)->{{x2:x,y2:y,success:True({}),error:"",status:s.machine.status,energy:s.machine.energy_joules,network:s.machine.network_id,health:s.machine.health_milli}} Error(e)->{{x2:x,y2:y,success:False({}),error:e,status:"",energy:0,network:0,health:0}}}}
{lamps:[lamp(111,-17),lamp(109,-33),lamp(109,-49),lamp(109,-65),lamp(89,-37),lamp(85,-47),lamp(77,-69),lamp(57,-69)],bot:match perform InspectBot({}) {Ok(s)->{{health:s.bot.health_milli,x:s.bot.x_milli,y:s.bot.y_milli,inventory:s.bot.inventory,error:""}} Error(e)->{{health:0,x:0,y:0,inventory:[],error:e}}}}
