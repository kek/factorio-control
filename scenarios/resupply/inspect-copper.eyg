let machine=(name,x,y)->{match perform InspectMachine({name:name,position:{x2:x,y2:y}}) {Ok(s)->{{name:name,x:x,y:y,health:s.machine.health_milli,status:s.machine.status,energy:s.machine.energy_joules,network:s.machine.network_id,fuel:s.machine.fuel,input:s.machine.input,output:s.machine.output,ammo:s.machine.ammo,error:""}} Error(e)->{{name:name,x:x,y:y,health:0,status:"missing",energy:0,network:0,fuel:[],input:[],output:[],ammo:[],error:e}}}}
let belt=(x,y)->{match perform InspectTransport({name:"transport-belt",position:{x2:x,y2:y}}) {Ok(s)->{{x:x,y:y,lanes:s.lanes,error:""}} Error(e)->{{x:x,y:y,lanes:[],error:e}}}}
let drill=(y)->{match perform InspectMachine({name:"burner-mining-drill",position:{x2:-136,y2:y}}) {Ok(s)->{{y:y,health:s.machine.health_milli,status:s.machine.status,fuel:s.machine.fuel,error:""}} Error(e)->{{y:y,health:0,status:"missing",fuel:[],error:e}}}}
{drills:[drill(4),drill(8),drill(12)],furnaces:[machine("stone-furnace",-132,4),machine("stone-furnace",-132,8),machine("stone-furnace",-132,12)],output_loaders:[machine("long-handed-inserter",-129,5),machine("long-handed-inserter",-129,9),machine("long-handed-inserter",-129,13)],guard:machine("gun-turret",-124,20),ammo_loader:machine("inserter",-127,19),belts:[belt(-129,19),belt(-125,13),belt(-125,-47),belt(-123,3),belt(-141,5)]}
