let points=[{x2:81,y2:-79},{x2:83,y2:-79},{x2:85,y2:-79},{x2:87,y2:-79},{x2:89,y2:-79},{x2:91,y2:-79},{x2:93,y2:-79},{x2:95,y2:-79},{x2:97,y2:-79},{x2:99,y2:-79},{x2:101,y2:-79},{x2:103,y2:-79},{x2:105,y2:-79},{x2:107,y2:-79},{x2:109,y2:-79},{x2:111,y2:-79},{x2:113,y2:-79},{x2:115,y2:-79},{x2:117,y2:-79},{x2:119,y2:-79},{x2:121,y2:-79},{x2:123,y2:-79},{x2:125,y2:-79},{x2:127,y2:-79},{x2:129,y2:-79},{x2:131,y2:-79},{x2:131,y2:-77},{x2:131,y2:-75},{x2:131,y2:-73},{x2:131,y2:-71},{x2:131,y2:-69},{x2:131,y2:-67},{x2:131,y2:-65},{x2:131,y2:-63},{x2:131,y2:-61},{x2:131,y2:-59},{x2:131,y2:-57}]
let observed=!list_fold(points,{checked:0,ammo:0,errors:0},(p,n)->{match perform InspectTransport({name:"transport-belt",position:p}) {Ok(s)->{let qty=!list_fold(s.lanes,0,(l,a)->{!list_fold(l.items,a,(i,a)->{match !equal(i.name,"firearm-magazine") {True(_)->{!int_add(a,i.count)} | (_)->{a}}})}) {checked:!int_add(n.checked,1),ammo:!int_add(n.ammo,qty),errors:n.errors}} Error(_)->{{checked:!int_add(n.checked,1),ammo:n.ammo,errors:!int_add(n.errors,1)}}}})
{checked:observed.checked,ammo:observed.ammo,errors:observed.errors}
