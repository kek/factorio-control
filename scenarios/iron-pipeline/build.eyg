// Sequential typed effects; failed steps stop this phase without resubmitting.
let bind = (result, next) -> {match result {Ok(value) -> {next(value)} Error(reason) -> {Error(reason)}}}
let unit = (result) -> {bind(result, (_) -> {Ok({})})}
let sequence = (steps) -> {!list_fold(steps, Ok({}), (step, result) -> {bind(result, step)})}
let count_item = (items, name) -> {
 !list_fold(items, 0, (stack, n) -> {match !equal(stack.name, name) {
  True(_) -> {!int_add(n, stack.count)} | (_) -> {n}
 }})
}
let lane = (x) -> {
 let x2 = !int_multiply(x, 2)
 let stage = match !int_compare(x, 30) {Lt(_) -> {!int_subtract(x, 2)} | (_) -> {!int_add(x, 2)}}
 let drill = match !equal(x, 29) {
  True(_) -> {(_) -> {Ok({})}}
  | (_) -> {(_) -> {unit(perform Build({position: {x2: x2, y2: -84}, item: "burner-mining-drill", direction: "south"}))}}
 }
 let furnace = match !equal(x, 29) {
  True(_) -> {(_) -> {Ok({})}}
  | (_) -> {(_) -> {unit(perform Build({position: {x2: x2, y2: -80}, item: "stone-furnace", direction: "north"}))}}
 }
 sequence([
  (_) -> {unit(perform WalkTo({position: {x2: !int_multiply(stage, 2), y2: -70}, timeout_ticks: 1800}))},
  (_) -> {unit(perform WalkTo({position: {x2: !int_multiply(stage, 2), y2: -76}, timeout_ticks: 1800}))},
  drill,
  furnace,
  (_) -> {unit(perform Build({position: {x2: !int_add(x2, 1), y2: -75}, item: "iron-chest", direction: "north"}))},
  (_) -> {unit(perform Build({position: {x2: !int_add(x2, 1), y2: -77}, item: "burner-inserter", direction: "north"}))},
  (_) -> {unit(perform Transfer({position: {x2: x2, y2: -84}, entity: "burner-mining-drill", inventory: "fuel", direction: "give", item: "coal", count: 20}))},
  (_) -> {unit(perform Transfer({position: {x2: x2, y2: -80}, entity: "stone-furnace", inventory: "fuel", direction: "give", item: "coal", count: 10}))},
  (_) -> {unit(perform Transfer({position: {x2: !int_add(x2, 1), y2: -77}, entity: "burner-inserter", inventory: "fuel", direction: "give", item: "coal", count: 3}))}
 ])
}
let job = bind(perform InspectBot({}), (s) -> {
 match !int_compare(count_item(s.bot.inventory, "coal"), 132) {
  Lt(_) -> {Error("At least 132 coal is needed before building the four lanes")}
  | (_) -> {sequence([
   (_) -> {unit(perform Craft({recipe: "burner-mining-drill", count: 3, timeout_ticks: 1800}))},
   (_) -> {unit(perform Craft({recipe: "burner-inserter", count: 4, timeout_ticks: 1800}))},
   (_) -> {unit(perform WalkTo({position: {x2: 58, y2: -68}, timeout_ticks: 1800}))},
   (_) -> {lane(25)},
   (_) -> {lane(29)},
   (_) -> {lane(33)},
   (_) -> {lane(37)}
  ])}
 }
})
match job {Ok(_) -> {{success: True({}), error: ""}} Error(reason) -> {{success: False({}), error: reason}}}
