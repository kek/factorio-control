// Staged placement; do not rerun a completed or uncertain phase.
let bind = (r, next) -> {match r {Ok(v) -> {next(v)} Error(e) -> {Error(e)}}}
let unit = (r) -> {bind(r, (_) -> {Ok({})})}
let tiles = [
 {x2: 41, y2: 19, direction: "north", walk: True({})},
 {x2: 41, y2: 17, direction: "north", walk: False({})},
 {x2: 41, y2: 15, direction: "north", walk: True({})},
 {x2: 41, y2: 13, direction: "north", walk: False({})},
 {x2: 41, y2: 11, direction: "north", walk: False({})},
 {x2: 41, y2: 9, direction: "north", walk: True({})},
 {x2: 41, y2: 7, direction: "north", walk: False({})},
 {x2: 41, y2: 5, direction: "north", walk: False({})},
 {x2: 41, y2: 3, direction: "north", walk: True({})},
 {x2: 41, y2: 1, direction: "north", walk: False({})},
 {x2: 41, y2: -1, direction: "north", walk: False({})},
 {x2: 41, y2: -3, direction: "north", walk: True({})},
 {x2: 41, y2: -5, direction: "north", walk: False({})},
 {x2: 41, y2: -7, direction: "north", walk: False({})},
 {x2: 41, y2: -9, direction: "north", walk: True({})},
 {x2: 41, y2: -11, direction: "north", walk: False({})},
 {x2: 41, y2: -13, direction: "north", walk: False({})},
 {x2: 41, y2: -15, direction: "north", walk: True({})},
 {x2: 41, y2: -17, direction: "north", walk: False({})},
 {x2: 41, y2: -19, direction: "north", walk: False({})},
 {x2: 41, y2: -21, direction: "north", walk: True({})},
 {x2: 41, y2: -23, direction: "north", walk: False({})},
 {x2: 41, y2: -25, direction: "north", walk: False({})},
 {x2: 41, y2: -27, direction: "north", walk: True({})},
 {x2: 41, y2: -29, direction: "north", walk: False({})},
 {x2: 41, y2: -31, direction: "north", walk: False({})},
 {x2: 41, y2: -33, direction: "north", walk: True({})},
 {x2: 41, y2: -35, direction: "north", walk: False({})},
 {x2: 41, y2: -37, direction: "north", walk: False({})},
 {x2: 41, y2: -39, direction: "north", walk: True({})},
 {x2: 41, y2: -41, direction: "north", walk: False({})},
 {x2: 41, y2: -43, direction: "north", walk: False({})}
]
let job = !list_fold(tiles, Ok({}), (tile, previous) -> {bind(previous, (_) -> {
 let ready = match tile.walk {True(_) -> {unit(perform WalkTo({position: {x2: tile.x2, y2: tile.y2}, timeout_ticks: 1800}))} | (_) -> {Ok({})}}
 bind(ready, (_) -> {unit(perform Build({position: {x2: tile.x2, y2: tile.y2}, item: "transport-belt", direction: tile.direction}))})
})})
match job {Ok(_) -> {{success: True({}), error: ""}} Error(e) -> {{success: False({}), error: e}}}
