// Staged placement; do not rerun a completed or uncertain phase.
let bind = (r, next) -> {match r {Ok(v) -> {next(v)} Error(e) -> {Error(e)}}}
let unit = (r) -> {bind(r, (_) -> {Ok({})})}
let tiles = [
 {x2: 41, y2: -45, direction: "north", walk: True({})},
 {x2: 41, y2: -47, direction: "north", walk: False({})},
 {x2: 41, y2: -49, direction: "north", walk: False({})},
 {x2: 41, y2: -51, direction: "north", walk: True({})},
 {x2: 41, y2: -53, direction: "north", walk: False({})},
 {x2: 41, y2: -55, direction: "north", walk: False({})},
 {x2: 41, y2: -57, direction: "north", walk: True({})},
 {x2: 41, y2: -59, direction: "north", walk: False({})},
 {x2: 41, y2: -61, direction: "north", walk: False({})},
 {x2: 41, y2: -63, direction: "north", walk: True({})},
 {x2: 41, y2: -65, direction: "north", walk: False({})},
 {x2: 41, y2: -67, direction: "north", walk: False({})},
 {x2: 41, y2: -69, direction: "north", walk: True({})},
 {x2: 41, y2: -71, direction: "north", walk: False({})},
 {x2: 41, y2: -73, direction: "north", walk: False({})},
 {x2: 41, y2: -75, direction: "north", walk: True({})},
 {x2: 41, y2: -77, direction: "north", walk: False({})},
 {x2: 41, y2: -79, direction: "north", walk: False({})},
 {x2: 41, y2: -81, direction: "north", walk: True({})},
 {x2: 41, y2: -83, direction: "north", walk: False({})},
 {x2: 41, y2: -85, direction: "north", walk: False({})},
 {x2: 41, y2: -87, direction: "north", walk: True({})},
 {x2: 41, y2: -89, direction: "east", walk: True({})},
 {x2: 43, y2: -89, direction: "east", walk: False({})},
 {x2: 45, y2: -89, direction: "south", walk: True({})},
 {x2: 45, y2: -87, direction: "south", walk: False({})},
 {x2: 45, y2: -85, direction: "south", walk: False({})},
 {x2: 45, y2: -83, direction: "south", walk: True({})},
 {x2: 45, y2: -81, direction: "south", walk: False({})},
 {x2: 45, y2: -79, direction: "south", walk: False({})},
 {x2: 45, y2: -77, direction: "east", walk: True({})},
 {x2: 47, y2: -77, direction: "south", walk: True({})}
]
let job = !list_fold(tiles, Ok({}), (tile, previous) -> {bind(previous, (_) -> {
 let ready = match tile.walk {True(_) -> {unit(perform WalkTo({position: {x2: tile.x2, y2: tile.y2}, timeout_ticks: 1800}))} | (_) -> {Ok({})}}
 bind(ready, (_) -> {unit(perform Build({position: {x2: tile.x2, y2: tile.y2}, item: "transport-belt", direction: tile.direction}))})
})})
match job {Ok(_) -> {{success: True({}), error: ""}} Error(e) -> {{success: False({}), error: e}}}
